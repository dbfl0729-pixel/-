import React, { useState, useMemo, useEffect } from 'react';
import { 
  Plus, 
  Search, 
  Trash2, 
  AlertTriangle, 
  Package, 
  TrendingUp, 
  Edit3, 
  Save, 
  X,
  ArrowUpDown,
  ChevronRight,
  ChevronLeft
} from 'lucide-react';

const App = () => {
  // --- 초기 데이터 및 상태 관리 ---
  const [items, setItems] = useState([
    { id: 1, name: '노트북 Pro 14', category: '전자기기', stock: 12, minStock: 5, price: 1500000 },
    { id: 2, name: '사무용 무선 마우스', category: '전자기기', stock: 45, minStock: 10, price: 35000 },
    { id: 3, name: '기계식 키보드', category: '전자기기', stock: 3, minStock: 8, price: 120000 },
    { id: 4, name: 'A4 용지 (500매)', category: '사무용품', stock: 100, minStock: 20, price: 5500 },
    { id: 5, name: '커피 믹스 100T', category: '식음료', stock: 2, minStock: 5, price: 18000 },
  ]);

  const [searchTerm, setSearchTerm] = useState('');
  const [editingId, setEditingId] = useState(null);
  const [newItem, setNewItem] = useState({ name: '', category: '', stock: '', minStock: '', price: '' });
  const [isAdding, setIsAdding] = useState(false);

  // --- 비즈니스 로직 ---
  
  // 품목 추가
  const handleAddItem = (e) => {
    e.preventDefault();
    if (!newItem.name || !newItem.category) return;
    
    const itemToAdd = {
      ...newItem,
      id: Date.now(),
      stock: parseInt(newItem.stock) || 0,
      minStock: parseInt(newItem.minStock) || 0,
      price: parseInt(newItem.price) || 0
    };
    
    setItems([...items, itemToAdd]);
    setNewItem({ name: '', category: '', stock: '', minStock: '', price: '' });
    setIsAdding(false);
  };

  // 품목 삭제
  const handleDelete = (id) => {
    setItems(items.filter(item => item.id !== id));
  };

  // 수정 시작
  const startEditing = (item) => {
    setEditingId(item.id);
  };

  // 수정 저장
  const saveEdit = (id, updatedValues) => {
    setItems(items.map(item => item.id === id ? { ...item, ...updatedValues } : item));
    setEditingId(null);
  };

  // 필터링된 목록
  const filteredItems = useMemo(() => {
    return items.filter(item => 
      item.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.category.toLowerCase().includes(searchTerm.toLowerCase())
    );
  }, [items, searchTerm]);

  // 통계 계산
  const stats = useMemo(() => {
    const totalItems = items.length;
    const lowStockCount = items.filter(item => item.stock <= item.minStock).length;
    const totalValue = items.reduce((acc, item) => acc + (item.stock * item.price), 0);
    return { totalItems, lowStockCount, totalValue };
  }, [items]);

  // 화폐 단위 변환
  const formatCurrency = (val) => new Intl.NumberFormat('ko-KR').format(val) + '원';

  return (
    <div className="min-h-screen bg-slate-50 p-4 md:p-8 font-sans text-slate-900">
      <div className="max-w-6xl mx-auto space-y-6">
        
        {/* 헤더 섹션 */}
        <header className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h1 className="text-3xl font-bold text-slate-800 tracking-tight">재고관리 시스템</h1>
            <p className="text-slate-500 mt-1">실시간 재고 현황 및 자산 가치를 확인하세요.</p>
          </div>
          <button 
            onClick={() => setIsAdding(!isAdding)}
            className="flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl transition-all shadow-md active:scale-95"
          >
            {isAdding ? <X size={20} /> : <Plus size={20} />}
            <span>{isAdding ? '취소' : '신규 품목 추가'}</span>
          </button>
        </header>

        {/* 대시보드 요약 카드 */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div className="bg-indigo-50 p-3 rounded-xl text-indigo-600">
              <Package size={28} />
            </div>
            <div>
              <p className="text-sm text-slate-500 font-medium">전체 품목</p>
              <p className="text-2xl font-bold">{stats.totalItems}종</p>
            </div>
          </div>
          <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div className={`p-3 rounded-xl ${stats.lowStockCount > 0 ? 'bg-amber-50 text-amber-600' : 'bg-emerald-50 text-emerald-600'}`}>
              <AlertTriangle size={28} />
            </div>
            <div>
              <p className="text-sm text-slate-500 font-medium">재고 부족</p>
              <p className={`text-2xl font-bold ${stats.lowStockCount > 0 ? 'text-amber-600' : 'text-emerald-600'}`}>
                {stats.lowStockCount}개
              </p>
            </div>
          </div>
          <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 flex items-center gap-4">
            <div className="bg-blue-50 p-3 rounded-xl text-blue-600">
              <TrendingUp size={28} />
            </div>
            <div>
              <p className="text-sm text-slate-500 font-medium">총 재고 가치</p>
              <p className="text-2xl font-bold">{formatCurrency(stats.totalValue)}</p>
            </div>
          </div>
        </div>

        {/* 품목 추가 폼 (조건부 렌더링) */}
        {isAdding && (
          <form onSubmit={handleAddItem} className="bg-white p-6 rounded-2xl shadow-lg border border-indigo-100 animate-in fade-in slide-in-from-top-4 duration-300">
            <h3 className="font-bold text-lg mb-4 text-slate-800">새로운 품목 정보를 입력하세요</h3>
            <div className="grid grid-cols-1 md:grid-cols-5 gap-4">
              <input 
                type="text" placeholder="품목명" required
                className="bg-slate-50 border border-slate-200 rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-indigo-500"
                value={newItem.name} onChange={e => setNewItem({...newItem, name: e.target.value})}
              />
              <input 
                type="text" placeholder="카테고리" required
                className="bg-slate-50 border border-slate-200 rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-indigo-500"
                value={newItem.category} onChange={e => setNewItem({...newItem, category: e.target.value})}
              />
              <input 
                type="number" placeholder="현재 재고" required
                className="bg-slate-50 border border-slate-200 rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-indigo-500"
                value={newItem.stock} onChange={e => setNewItem({...newItem, stock: e.target.value})}
              />
              <input 
                type="number" placeholder="최소 재고" required
                className="bg-slate-50 border border-slate-200 rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-indigo-500"
                value={newItem.minStock} onChange={e => setNewItem({...newItem, minStock: e.target.value})}
              />
              <input 
                type="number" placeholder="단가" required
                className="bg-slate-50 border border-slate-200 rounded-lg p-2.5 outline-none focus:ring-2 focus:ring-indigo-500"
                value={newItem.price} onChange={e => setNewItem({...newItem, price: e.target.value})}
              />
            </div>
            <div className="mt-4 flex justify-end">
              <button type="submit" className="bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-indigo-700 transition-colors">
                저장하기
              </button>
            </div>
          </form>
        )}

        {/* 리스트 컨트롤 (검색) */}
        <div className="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
          <div className="p-4 border-b border-slate-100 bg-white sticky top-0 z-10">
            <div className="relative max-w-md">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
              <input 
                type="text" 
                placeholder="검색 (품명, 카테고리)..."
                className="w-full bg-slate-50 border border-slate-200 rounded-xl py-2 pl-10 pr-4 outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm"
                value={searchTerm}
                onChange={(e) => setSearchTerm(e.target.value)}
              />
            </div>
          </div>

          {/* 재고 테이블 */}
          <div className="overflow-x-auto">
            <table className="w-full text-left border-collapse min-w-[800px]">
              <thead className="bg-slate-50/50 text-slate-500 text-xs font-bold uppercase tracking-wider">
                <tr>
                  <th className="px-6 py-4">카테고리</th>
                  <th className="px-6 py-4">품명</th>
                  <th className="px-6 py-4 text-center">재고 현황</th>
                  <th className="px-6 py-4 text-right">단가</th>
                  <th className="px-6 py-4 text-right">총 자산 가치</th>
                  <th className="px-6 py-4 text-center">관리</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100">
                {filteredItems.map(item => (
                  <tr key={item.id} className="group hover:bg-slate-50/80 transition-colors">
                    <td className="px-6 py-4">
                      <span className="text-xs font-semibold px-2 py-1 bg-slate-100 rounded-md text-slate-600">
                        {item.category}
                      </span>
                    </td>
                    <td className="px-6 py-4 font-medium text-slate-800">
                      {editingId === item.id ? (
                        <input 
                          autoFocus
                          className="w-full border-b border-indigo-500 outline-none bg-transparent"
                          defaultValue={item.name}
                          onBlur={(e) => saveEdit(item.id, { name: e.target.value })}
                        />
                      ) : (
                        item.name
                      )}
                    </td>
                    <td className="px-6 py-4">
                      <div className="flex flex-col items-center gap-1">
                        <div className="flex items-center gap-2">
                          {item.stock <= item.minStock && (
                            <AlertTriangle size={14} className="text-amber-500" />
                          )}
                          <span className={`font-bold ${item.stock <= item.minStock ? 'text-amber-600' : 'text-slate-700'}`}>
                            {item.stock}
                          </span>
                        </div>
                        <div className="w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                          <div 
                            className={`h-full rounded-full ${item.stock <= item.minStock ? 'bg-amber-400' : 'bg-emerald-400'}`}
                            style={{ width: `${Math.min((item.stock / (item.minStock * 2)) * 100, 100)}%` }}
                          ></div>
                        </div>
                        <span className="text-[10px] text-slate-400 uppercase font-medium">최소 권장: {item.minStock}</span>
                      </div>
                    </td>
                    <td className="px-6 py-4 text-right text-slate-600 text-sm">
                      {editingId === item.id ? (
                        <input 
                          type="number"
                          className="w-24 border-b border-indigo-500 text-right outline-none bg-transparent"
                          defaultValue={item.price}
                          onBlur={(e) => saveEdit(item.id, { price: parseInt(e.target.value) })}
                        />
                      ) : (
                        formatCurrency(item.price)
                      )}
                    </td>
                    <td className="px-6 py-4 text-right">
                      <span className="font-semibold text-slate-800">
                        {formatCurrency(item.stock * item.price)}
                      </span>
                    </td>
                    <td className="px-6 py-4">
                      <div className="flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                        <button 
                          onClick={() => startEditing(item)}
                          className="p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all"
                          title="수정"
                        >
                          <Edit3 size={18} />
                        </button>
                        <button 
                          onClick={() => handleDelete(item.id)}
                          className="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-all"
                          title="삭제"
                        >
                          <Trash2 size={18} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
                {filteredItems.length === 0 && (
                  <tr>
                    <td colSpan="6" className="px-6 py-20 text-center text-slate-400">
                      <div className="flex flex-col items-center gap-2">
                        <Search size={40} className="text-slate-200" />
                        <p>검색 결과가 없거나 품목이 존재하지 않습니다.</p>
                      </div>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          
          {/* 하단 페이지네이션 모바일 디자인용/확장용 */}
          <div className="bg-slate-50/30 px-6 py-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-medium">
            <span>총 {filteredItems.length}개의 품목 표시 중</span>
            <div className="flex gap-2">
              <button className="p-1 hover:bg-white rounded border border-slate-200 disabled:opacity-50" disabled><ChevronLeft size={16} /></button>
              <button className="p-1 hover:bg-white rounded border border-slate-200 disabled:opacity-50" disabled><ChevronRight size={16} /></button>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default App;